---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <canvas id="wave-canvas"></canvas>
    
    <div class="page-content-wrapper">
        <div class="breadcrumb-area">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="breadcrumb-inner text-center">
                            <h1 class="title split-collab">Contact</h1>
                            <ul class="page-list">
                                <li class="tmp-breadcrumb-item"><a href="/">Home</a></li>
                                <li class="icon"><i class="fa-solid fa-angle-right"></i></li>
                                <li class="tmp-breadcrumb-item active">Contact</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="contact-area-wrapper tmp-section-gap">
            <div class="container">
                <div class="contact-info-wrap">
                    <div class="row">
                        <div class="col-lg-4 col-md-6">
                            <div class="contact-info tmp-scroll-trigger tmponhover tmp-fade-in animation-order-1">
                                <div class="contact-icon">
                                    <i class="fa-solid fa-location-dot"></i>
                                </div>
                                <h3 class="title">Location</h3>
                                <p class="para">Johannesburg, Gauteng</p>
                                <p class="para">South Africa</p>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="contact-info tmp-scroll-trigger tmponhover tmp-fade-in animation-order-2">
                                <div class="contact-icon">
                                    <i class="fa-solid fa-envelope"></i>
                                </div>
                                <h3 class="title">E-mail</h3>
                                <a href="mailto:connect@azungu.co.za">
                                    <p class="para">connect@azungu.co.za</p>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="contact-info tmp-scroll-trigger tmponhover tmp-fade-in animation-order-3">
                                <div class="contact-icon">
                                    <i class="fa-brands fa-whatsapp"></i>
                                </div>
                                <h3 class="title">Whatsapp</h3>
                                <p class="para">+27 (77) 420 4639</p>
                                <p class="para">Monday - Friday: 09:00am - 15:00pm</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        <section class="get-in-touch-area tmp-section-gapTop">
            <div class="container">
                <div class="contact-get-in-touch-wrap">
                    <div class="get-in-touch-wrapper tmponhover">
                        <div class="row g-5 align-items-center">
                            <div class="col-lg-5">
                                <div class="section-head text-align-left">
                                    <div class="section-sub-title tmp-scroll-trigger tmp-fade-in animation-order-1">
                                        <span class="subtitle">GET IN TOUCH</span>
                                    </div>
                                    <h2 class="title split-collab tmp-scroll-trigger tmp-fade-in animation-order-2">Elevate Your Brand</h2>
                                    <p class="description tmp-scroll-trigger tmp-fade-in animation-order-3">Let's collaborate to bring your vision to life and elevate your brand in the digital space.</p>
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <div class="contact-inner">
                                    <div class="contact-form">
                                        <div id="form-messages" class="error"></div>
                                        <form class="tmp-dynamic-form" id="contact-form" method="POST" action="/mailer.php">
                                            <div class="contact-form-wrapper row g-3">
                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <input class="input-field" name="name" id="contact-name" placeholder="Your Name" type="text" required>
                                                    </div>
                                                </div>

                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <input class="input-field" id="contact-phone" name="phone" placeholder="Phone Number" type="tel" inputmode="tel" autocomplete="tel" required>
                                                    </div>
                                                </div>

                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <input class="input-field" id="contact-email" name="email" placeholder="Your Email" type="email" required>
                                                    </div>
                                                </div>

                                                <div class="col-lg-6">
                                                    <div class="form-group">
                                                        <input class="input-field" type="text" id="subject" name="subject" placeholder="Subject">
                                                    </div>
                                                </div>

                                                <div class="col-lg-12">
                                                    <div class="form-group">
                                                        <textarea class="input-field" placeholder="Your Message" name="message" id="contact-message" required></textarea>
                                                    </div>
                                                </div>

                                                <div class="col-lg-12">
                                                    <div class="tmp-button-here">
                                                        <button class="tmp-btn hover-icon-reverse radius-round w-100" name="submit" type="submit" id="submit">
                                                            <span class="icon-reverse-wrapper">
                                                                <span class="btn-text">Submit</span>
                                                                <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span>
                                                                <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right"></i></span>
                                                            </span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        </div>
    </div>
    
</Layout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const canvas = document.getElementById('wave-canvas') as HTMLCanvasElement;
        
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let width: number, height: number;
            let time = 0;

            // Fit canvas to the full browser window
            const resize = () => {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            };
            
            window.addEventListener('resize', resize);
            resize();

            const draw = () => {
                if (!ctx) return;
                
                // Clear the frame for continuous drawing
                ctx.clearRect(0, 0, width, height);
                
                // Styling the lines
                ctx.lineWidth = 0.6; // Very thin
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.08)'; // Faint grey lines

                // Helper to draw grouped flowing ribbons
                const drawRibbonGroup = (baseY: number, amplitude: number, phaseOffset: number, lineCount: number, spacing: number, speedDirection: number) => {
                    for (let i = 0; i < lineCount; i++) {
                        ctx.beginPath();
                        // Drawing points across the screen
                        for (let x = 0; x <= width; x += 15) {
                            const normalizedX = x / width;
                            let y = baseY + (i * spacing);
                            
                            // Combine multiple sine waves to create topographical organic curves
                            y += Math.sin(normalizedX * 3.0 + time * 0.4 * speedDirection + phaseOffset) * amplitude;
                            y += Math.sin(normalizedX * 1.5 - time * 0.2 + i * 0.05) * (amplitude * 0.5);
                            
                            if (x === 0) {
                                ctx.moveTo(x, y);
                            } else {
                                ctx.lineTo(x, y);
                            }
                        }
                        ctx.stroke();
                    }
                };

                // Render negative space and line groups across the whole screen height
                
                // 1. Top Right flowing lines
                drawRibbonGroup(height * 0.1, height * 0.2, 1.5, 15, 12, 1);
                
                // 2. Middle sweeping lines
                drawRibbonGroup(height * 0.5, height * 0.25, 3.0, 8, 20, -1);
                
                // 3. Bottom Left dense sweeping lines
                drawRibbonGroup(height * 0.9, height * 0.2, 4.0, 22, -10, -1);
                
                // 4. Bottom Right arching waves
                drawRibbonGroup(height * 1.1, -(height * 0.15), 2.5, 12, -8, 1);

                // Increment time for continuous flowing animation
                time += 0.012;
                requestAnimationFrame(draw);
            };
            
            draw();
        }
    });
</script>
