<style is:inline>
        /* 1. Constrain the glass container height and hide its own overflow */
        .portfolio-modal-glass {
            max-height: 85vh;
            display: flex;
            flex-direction: column;
            overflow: hidden; /* This keeps the glass background solid and unbroken */
        }

        /* 2. Target the new inner wrapper to handle all the scrolling */
        .modal-scroll-wrapper {
            overflow-y: auto;
            overflow-x: hidden;
            scroll-behavior: smooth;
            padding-right: 15px; /* Spacing for the scrollbar */
            margin-right: -5px; /* Offsets padding slightly */
            flex-grow: 1; /* Fills up the remaining space inside the glass box */
        }

        /* 3. Custom Scrollbar Styling */
        .modal-scroll-wrapper::-webkit-scrollbar {
            width: 6px;
        }
        .modal-scroll-wrapper::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
            border-radius: 10px;
        }
        .modal-scroll-wrapper::-webkit-scrollbar-thumb {
            background: rgba(150, 150, 150, 0.4);
            border-radius: 10px;
        }
        .modal-scroll-wrapper::-webkit-scrollbar-thumb:hover {
            background: rgba(150, 150, 150, 0.7);
        }
    </style>

    <div id="servicesModal" class="portfolio-modal-overlay">
        <div class="portfolio-modal-glass tmponhover">
            <span class="portfolio-modal-close" id="closeServicesModal">&times;</span>
            
            <div class="modal-scroll-wrapper">
                <h3 class="modal-title">Start Your Project</h3>
                <p class="modal-subtitle">Fill in your details and let's discuss your project.</p>
                
                <form id="servicesForm" class="portfolio-form">
                    <div class="form-group">
                        <label for="servFullName">Full Name <span class="required">*</span></label>
                        <input type="text" id="servFullName" name="servFullName" required placeholder="John Doe">
                    </div>
                    
                    <div class="form-group">
                        <label for="servEmail">Email Address <span class="required">*</span></label>
                        <input type="email" id="servEmail" name="servEmail" required placeholder="john@example.com">
                    </div>
                    
                    <div class="form-group">
                        <label for="servPhone">Phone Number</label>
                        <input type="tel" id="servPhone" name="servPhone" placeholder="eg. 0774204639">
                        
                        <div id="whatsappCheckboxContainer" style="display: none; margin-top: 12px; align-items: center; gap: 8px;">
                            <input type="checkbox" id="servWhatsApp" name="servWhatsApp" style="width: auto; margin-bottom: 0; transform: translateY(1px);">
                            <label for="servWhatsApp" class="modal-subtitle" style="margin-bottom: 0; cursor: pointer; display: inline-block;">Contact on WhatsApp</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="servCompany">Company</label>
                        <input type="text" id="servCompany" name="servCompany" placeholder="Your Company Ltd.">
                    </div>

                    <div class="form-group">
                        <label for="servWebsite">Website</label>
                        <input type="url" id="servWebsite" name="servWebsite" placeholder="https://example.com">
                    </div>

                    <div class="form-group">
                        <label>Services required <span class="required">*</span></label>
                        <div class="radio-wrapper" style="margin-top: 10px;">
                            <div class="radio-item">
                                <input type="radio" id="servGraphic" name="servRequired" value="Graphic Design" required class="white-radio">
                                <label for="servGraphic">Graphic Design</label>
                            </div>
                            <div class="radio-item">
                                <input type="radio" id="servWeb" name="servRequired" value="Web Design & Development" required class="white-radio">
                                <label for="servWeb">Web Design & Development</label>
                            </div>
                            <div class="radio-item">
                                <input type="radio" id="servSocial" name="servRequired" value="Social Media Management" required class="white-radio">
                                <label for="servSocial">Social Media Management</label>
                            </div>
                            <div class="radio-item">
                                <input type="radio" id="servBranding" name="servRequired" value="Branding" required class="white-radio">
                                <label for="servBranding">Branding</label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="servProjectDetails">Tell Me About Your Project <span class="required">*</span></label>
                        <textarea id="servProjectDetails" name="servProjectDetails" rows="4" required placeholder="Briefly describe your goals, timeline, and any specific requirements..." style="width: 100%; padding: 15px; background: transparent; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 6px; color: var(--color-white); outline: none;"></textarea>
                    </div>

                    <div class="form-group">
                        <label for="servFileUpload">Upload Relevant Files (Optional)</label>
                        <input type="file" id="servFileUpload" name="servFileUpload" multiple accept="image/*,.pdf,.doc,.docx" style="width: 100%; padding: 12px 15px; background: rgba(255, 255, 255, 0.05); border: 1px dashed rgba(255, 255, 255, 0.3); border-radius: 6px; color: var(--color-white); cursor: pointer;">
                    </div>

                    <div class="form-group" style="display: flex; align-items: flex-start; gap: 10px; margin-top: 20px; margin-bottom: 25px;">
                        <input type="checkbox" id="servConfirm" name="servConfirm" required style="width: auto; margin-top: 4px; cursor: pointer;">
                        <label for="servConfirm" class="modal-subtitle" style="margin-bottom: 0; cursor: pointer; text-align: left; font-size: 14px; line-height: 1.5;">I confirm that the details provided are accurate and I agree to be contacted regarding this project. <span class="required">*</span></label>
                    </div>

                    <button type="submit" class="tmp-btn hover-icon-reverse radius-round w-100">
                        <span class="icon-reverse-wrapper">
                            <span class="btn-text">Submit</span>
                            <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span>
                            <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span>
                        </span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div id="loginModal" class="portfolio-modal-overlay">
        <div class="portfolio-modal-glass tmponhover">
            <span class="portfolio-modal-close" id="closeLoginModal">&times;</span>
            
            <div class="modal-scroll-wrapper">
                <h3 class="modal-title">Log In</h3>
                <p class="modal-subtitle">Fill in your details to see your designs.</p>
                
                <form id="loginForm" class="portfolio-form">
                    <div class="form-group">
                        <label for="lognProject"> Email/WhatsApp Number <span class="required">*</span></label>
                        <input type="text" id="lognProject" name="lognProject" required placeholder="eg. '0774204639' or 'connect@azungu.co.za'">
                    </div>
                    
                    <div class="form-group">
                        <label for="lognOTP">Access Code <span class="required">*</span></label>
                        <input type="text" id="lognOTP" name="lognOTP" required placeholder="The Code You Received Via Email/Whatsapp">
                    </div>
                    <p class="modal-subtitle">Reset Code</p>
                    <button type="submit" class="tmp-btn hover-icon-reverse radius-round w-100">
                        <span class="icon-reverse-wrapper">
                            <span class="btn-text">Submit</span>
                            <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span>
                            <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span>
                        </span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div id="successPopup" class="portfolio-modal-overlay" style="z-index: 9999;">
        <div class="portfolio-modal-glass tmponhover" style="text-align: center; padding: 40px 30px; max-width: 450px; margin: auto; height: auto;">
            <span class="portfolio-modal-close" id="closeSuccessPopupIcon">&times;</span>
            
            <div style="font-size: 50px; color: #FF8C33; margin-bottom: 20px;">
                <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
            </div>
            
            <h3 class="modal-title" style="margin-bottom: 15px;">That Did Not Work</h3>
            <p class="modal-subtitle" style="font-size: 16px; margin-bottom: 30px;">Unfortunately, we’ve stumbled upon an issue processing your request. Please send us a WhatsApp on 077 420 4639 or email connect@azungu.co.za, and we’ll assist you as soon as possible.</p>
            
            <button type="button" id="closeSuccessBtn" class="tmp-btn hover-icon-reverse radius-round w-100">
                <span class="icon-reverse-wrapper">
                    <span class="btn-text">Awesome</span>
                    <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span>
                    <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span>
                </span>
            </button>
        </div>
    </div>

