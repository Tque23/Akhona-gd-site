    <script is:inline defer src="/_vercel/speed-insights/script.js"></script>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        // --- 1. Portfolio Modal Logic (From index.astro) ---
        const portfolioModal = document.getElementById("portfolioModal");
        const openPortfolioBtn = document.getElementById("openPortfolioModal");
        const closePortfolioBtn = document.getElementById("closePortfolioModal");

        if (openPortfolioBtn) {
            openPortfolioBtn.addEventListener('click', (e) => { 
                e.preventDefault(); 
                portfolioModal.classList.add("show"); 
            });
        }
        if (closePortfolioBtn) {
            closePortfolioBtn.addEventListener('click', () => portfolioModal.classList.remove("show"));
        }

        // --- 2. Services Modal Logic ---
        const servicesModal = document.getElementById("servicesModal");
        const closeServicesBtn = document.getElementById("closeServicesModal");
        const servicesModalHash = "#start-your-project";

        const openServicesModal = (updateUrl = true) => {
            // Close the login modal if it's currently open
            const loginModalEl = document.getElementById("loginModal");
            if (loginModalEl && loginModalEl.classList.contains("show")) {
                loginModalEl.classList.remove("show");
            }

            servicesModal?.classList.add("show");
            if (updateUrl && window.location.hash !== servicesModalHash) {
                window.history.pushState(null, "", servicesModalHash);
            }
        };

        const closeServicesModal = () => {
            servicesModal?.classList.remove("show");
            if (window.location.hash === servicesModalHash) {
                window.history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
            }
        };

        const syncServicesModalWithHash = () => {
            if (window.location.hash === servicesModalHash) servicesModal?.classList.add("show");
            else servicesModal?.classList.remove("show");
        };

        // Use event delegation so dynamic/recreated buttons still work
        document.addEventListener('click', (e) => {
            // Check if what was clicked (or its parent) has the class
            const btn = e.target.closest('.openServicesModal');
            
            if (btn) {
                e.preventDefault();
                openServicesModal();
            }
        });

        if (closeServicesBtn) {
            closeServicesBtn.addEventListener('click', closeServicesModal);
        }

        window.addEventListener("hashchange", syncServicesModalWithHash);
        window.addEventListener("popstate", syncServicesModalWithHash);
        syncServicesModalWithHash();

        // --- 3. Login & Portal Logic ---
        const loginModal = document.getElementById("loginModal");
        const openLoginBtns = document.querySelectorAll(".openLoginModal");
        const closeLoginBtn = document.getElementById("closeLoginModal");
        const loginForm = document.getElementById("loginForm");
        const modalScrollWrapper = loginModal.querySelector(".modal-scroll-wrapper");

        document.addEventListener("click", (event) => {
            const toggle = event.target.closest("[data-password-toggle]");
            if (!toggle) return;

            const passwordInput = document.getElementById(toggle.getAttribute("aria-controls"));
            if (!passwordInput) return;

            const isPasswordVisible = passwordInput.type === "text";
            passwordInput.type = isPasswordVisible ? "password" : "text";
            toggle.setAttribute("aria-pressed", String(!isPasswordVisible));
            toggle.setAttribute("aria-label", isPasswordVisible ? "Show access code" : "Hide access code");
            toggle.querySelector("i").className = isPasswordVisible ? "fa-regular fa-eye" : "fa-regular fa-eye-slash";
        });

        // Save original modal HTML so we can restore it on close
        const originalLoginHTML = modalScrollWrapper.innerHTML; 

        // PASTE YOUR GOOGLE APPS SCRIPT WEB APP URL HERE
        const GOOGLE_API_URL = "https://script.google.com/macros/s/AKfycbys6hUSU-zPewgXmP5YNcQGizJJL1zu-sR8XjA7YZeP31P4y3Da8Ol6GzTZO7kzqtq5rg/exec";

        // Store the client's projects in memory after login
        let clientProjects = [];
        let activePreviewClose = null;

        function buildPortalPreviewCardMarkup(imageSrc, projectName) {
            return `
                <div class="portal-preview-img mb--20">
                    <img src="${imageSrc}" alt="${projectName} Preview" draggable="false">
                    <button type="button" class="portal-preview-view" aria-label="View project preview">
                        <span class="portal-preview-view__content">
                            <span class="portal-preview-view__icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
                            <span>View</span>
                        </span>
                    </button>
                </div>
            `;
        }

        function buildPortalPreviewLoaderMarkup() {
            return `
                <div class="portal-preview-slot mb--20" data-portal-preview-slot>
                    <div class="portal-preview-loader portal-preview-loader--inline" data-portal-card-loader role="status" aria-live="polite">
                        <div class="portal-preview-loader__mark" aria-hidden="true">
                            <span class="portal-preview-loader__cube portal-preview-loader__cube--colour"></span>
                            <span class="portal-preview-loader__cube portal-preview-loader__cube--glass"></span>
                        </div>
                    </div>
                </div>
            `;
        }

        function mountPortalPreviewCard(slot, imageSrc, projectName) {
            const loaderShownAt = Date.now();
            const minLoaderMs = 280;
            const preload = new Image();
            let settled = false;

            const finish = (success) => {
                if (settled || !slot.isConnected) return;
                settled = true;

                const revealCard = () => {
                    if (!slot.isConnected) return;
                    if (success) {
                        slot.outerHTML = buildPortalPreviewCardMarkup(imageSrc, projectName);
                        return;
                    }

                    const loader = slot.querySelector("[data-portal-card-loader]");
                    loader?.classList.add("is-error");
                    const label = loader?.querySelector(".portal-preview-loader__label");
                    if (label) label.textContent = "Preview unavailable";
                };

                const elapsed = Date.now() - loaderShownAt;
                const remaining = minLoaderMs - elapsed;
                if (remaining > 0) window.setTimeout(revealCard, remaining);
                else revealCard();
            };

            preload.addEventListener("load", () => finish(true), { once: true });
            preload.addEventListener("error", () => finish(false), { once: true });
            preload.src = imageSrc;

            if (preload.complete) {
                if (preload.naturalWidth > 0) finish(true);
                else finish(false);
            }
        }

        function openProjectPreview(source, description) {
            if (activePreviewClose) activePreviewClose();
            loginModal.classList.add("show");

            const viewer = document.createElement("div");
            viewer.className = "portal-image-viewer is-ready";
            viewer.setAttribute("role", "dialog");
            viewer.setAttribute("aria-modal", "true");
            viewer.setAttribute("aria-label", description || "Project preview");
            viewer.innerHTML = `
                <div class="portal-image-viewer__backdrop" data-preview-close></div>
                <section class="portal-image-viewer__bubble">
                    <button class="portal-image-viewer__close" type="button" data-preview-close aria-label="Close preview"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                    <div class="portal-image-viewer__stage">
                        <img class="portal-image-viewer__image" draggable="false">
                    </div>
                    <div class="portal-image-viewer__controls" aria-label="Image zoom controls">
                        <button type="button" data-preview-zoom-out aria-label="Zoom out"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                        <button type="button" data-preview-reset aria-label="Reset zoom"><span data-preview-zoom-label>100%</span></button>
                        <button type="button" data-preview-zoom-in aria-label="Zoom in"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                    </div>
                </section>
            `;

            const image = viewer.querySelector(".portal-image-viewer__image");
            const stage = viewer.querySelector(".portal-image-viewer__stage");
            const bubble = viewer.querySelector(".portal-image-viewer__bubble");
            const zoomLabel = viewer.querySelector("[data-preview-zoom-label]");
            let scale = 1;
            let offsetX = 0;
            let offsetY = 0;
            let dragStart = null;

            image.alt = description || "Project preview";

            const fitViewerToImage = () => {
                const ratio = image.naturalWidth / image.naturalHeight;
                if (!Number.isFinite(ratio) || ratio <= 0) return;

                const controlsHeight = 72;
                const availableWidth = Math.max(240, window.innerWidth - 36);
                const availableHeight = Math.max(240, window.innerHeight - 36 - controlsHeight);
                const imageWidth = Math.min(availableWidth, availableHeight * ratio);
                const imageHeight = imageWidth / ratio;

                bubble.style.width = `${Math.round(imageWidth)}px`;
                bubble.style.height = `${Math.round(imageHeight + controlsHeight)}px`;
                stage.style.width = `${Math.round(imageWidth)}px`;
                stage.style.height = `${Math.round(imageHeight)}px`;
            };

            const onResize = () => fitViewerToImage();

            const updateImage = () => {
                image.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
                zoomLabel.textContent = `${Math.round(scale * 100)}%`;
                stage.classList.toggle("is-zoomed", scale > 1);
            };

            const setZoom = (nextScale) => {
                scale = Math.min(3, Math.max(1, Number(nextScale.toFixed(2))));
                if (scale === 1) {
                    offsetX = 0;
                    offsetY = 0;
                }
                updateImage();
            };

            const preventCopy = (event) => event.preventDefault();
            const onKeyDown = (event) => {
                if (event.key === "Escape") close();
                if (event.key === "+" || event.key === "=") {
                    event.preventDefault();
                    setZoom(scale + 0.2);
                }
                if (event.key === "-") {
                    event.preventDefault();
                    setZoom(scale - 0.2);
                }
            };
            const close = () => {
                document.removeEventListener("keydown", onKeyDown);
                document.removeEventListener("copy", preventCopy);
                window.removeEventListener("resize", onResize);
                viewer.remove();
                document.body.classList.remove("portal-preview-open");
                if (activePreviewClose === close) activePreviewClose = null;
            };

            viewer.addEventListener("click", (event) => {
                event.stopPropagation();
                if (event.target.closest("[data-preview-close]")) close();
            });
            viewer.addEventListener("contextmenu", (event) => event.preventDefault());
            viewer.addEventListener("dragstart", (event) => event.preventDefault());
            viewer.addEventListener("selectstart", (event) => event.preventDefault());
            viewer.querySelector("[data-preview-zoom-in]").addEventListener("click", () => setZoom(scale + 0.2));
            viewer.querySelector("[data-preview-zoom-out]").addEventListener("click", () => setZoom(scale - 0.2));
            viewer.querySelector("[data-preview-reset]").addEventListener("click", () => setZoom(1));
            stage.addEventListener("wheel", (event) => {
                event.preventDefault();
                setZoom(scale + (event.deltaY < 0 ? 0.2 : -0.2));
            }, { passive: false });
            stage.addEventListener("pointerdown", (event) => {
                if (scale === 1) return;
                dragStart = { x: event.clientX, y: event.clientY, offsetX, offsetY };
                stage.setPointerCapture(event.pointerId);
            });
            stage.addEventListener("pointermove", (event) => {
                if (!dragStart) return;
                offsetX = dragStart.offsetX + event.clientX - dragStart.x;
                offsetY = dragStart.offsetY + event.clientY - dragStart.y;
                updateImage();
            });
            stage.addEventListener("pointerup", () => { dragStart = null; });
            stage.addEventListener("pointercancel", () => { dragStart = null; });

            document.body.appendChild(viewer);
            document.body.classList.add("portal-preview-open");
            document.addEventListener("keydown", onKeyDown);
            document.addEventListener("copy", preventCopy);
            window.addEventListener("resize", onResize);
            image.addEventListener("load", fitViewerToImage, { once: true });
            if (source) {
                image.src = source;
                if (image.complete && image.naturalWidth > 0) fitViewerToImage();
            }
            activePreviewClose = close;
            viewer.querySelector(".portal-image-viewer__close").focus();
        }

        document.addEventListener("click", (event) => {
            const viewButton = event.target.closest(".portal-preview-view");
            if (!viewButton) return;

            event.preventDefault();
            event.stopPropagation();
            const previewImage = viewButton.closest(".portal-preview-img")?.querySelector("img");
            if (previewImage) openProjectPreview(previewImage.currentSrc || previewImage.src, previewImage.alt);
        });

        document.addEventListener("contextmenu", (event) => {
            if (event.target.closest(".portal-preview-img")) event.preventDefault();
        });

        document.addEventListener("dragstart", (event) => {
            if (event.target.closest(".portal-preview-img")) event.preventDefault();
        });

        if (openLoginBtns.length > 0) {
            openLoginBtns.forEach(btn => {
                btn.addEventListener('click', (e) => { 
                    e.preventDefault(); 
                    modalScrollWrapper.innerHTML = originalLoginHTML; // Reset to login view
                    attachLoginFormListener(); // Re-attach listener to the fresh form
                    loginModal.classList.add("show"); 
                });
            });
        }

        if (closeLoginBtn) {
            closeLoginBtn.addEventListener('click', () => {
                loginModal.classList.remove("show");
            });
        }

        function attachLoginFormListener() {
            const form = document.getElementById("loginForm");
            if (!form) return;

            const submitBtnText = form.querySelector(".btn-text");
            const setSubmitButtonText = (text, isShimmering = false) => {
                if (submitBtnText) {
                    submitBtnText.innerText = text;
                    submitBtnText.classList.toggle("shimmer-text", isShimmering);
                }
            };

            form.addEventListener("submit", async function(e) {
                e.preventDefault();
                
                const user = document.getElementById("lognProject").value;
                const otp = document.getElementById("lognOTP").value;
                
                setSubmitButtonText("Authenticating...", true);

                try {
                    const response = await fetch(GOOGLE_API_URL, {
                        method: "POST",
                        body: JSON.stringify({ user, otp }),
                        headers: { "Content-Type": "text/plain;charset=utf-8" }
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        clientProjects = data.projects;
                        window.renderDashboard();
                    } else {
                        alert(data.message);
                        setSubmitButtonText("Submit", false);
                    }
                } catch (error) {
                    alert("Connection error. Please try again.");
                    setSubmitButtonText("Submit", false);
                }
            });
        }

        window.renderDashboard = function() {
            let dashboardHTML = `<h3>Your Projects</h3> <hr style="border: none; border-top: 1px solid rgba(255, 255, 255, 0.1); margin: 20px 0;">`;
            
            // Use .map and .join to insert the HR line between items
            dashboardHTML += clientProjects.map((project, index) => {
                const isPaid = project.paid === true || String(project.paid).toLowerCase() === 'true';
                const paymentText = isPaid ? "Paid" : "Outstanding Payment";
                const paymentColor = isPaid ? "green" : "red";
                
                // This is the HTML for the project card
                let card = `
                    <div class="portal-project-card" onclick="window.renderProjectView(${index})">
                        <div class="portal-project-info">
                            <h4>${project.projectType}</h4>
                            <span class="portal-tag">${project.projectCompletion}</span>
                        </div>
                        <div class="portal-project-arrow">
                            <span class="portal-view-text" style="color: ${paymentColor}; font-weight: bold;">${paymentText}</span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </div>
                    </div>
                `;

                // Only add the HR line if it's NOT the last project
                if (index < clientProjects.length - 1) {
                    card += `<hr style="border: none; border-top: 1px solid rgba(255, 255, 255, 0.1); margin: 20px 0;">`;
                }
                
                return card;
            }).join('');

            modalScrollWrapper.innerHTML = dashboardHTML;
        }

        // Make the function available globally so inline onclick events can reach it
        window.renderProjectView = function(index) {
            const project = clientProjects[index];
            const isPaid = project.paid === 'TRUE';
            
            // Grey out logic
            const btnClass = isPaid ? "tmp-btn hover-icon-reverse radius-round w-100" : "tmp-btn w-100 disabled-btn";
            const btnText = isPaid ? "Download Files" : "Payment Pending";
            const disabledAttr = isPaid ? "" : 'aria-disabled="true" tabindex="-1"';
            const downloadHref = isPaid
                ? `href="${project.downloadLink}" download="${project.projectName || 'project-download'}"`
                : `href="#"`;

            const projectHTML = `
                <button class="portal-back-btn" onclick="window.renderDashboard()">
                    <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
                </button>
                
                <h3 class="modal-title" style="margin-top:20px;">${project.projectType}</h3>
                <span class="portal-tag mb--20" style="display:inline-block; color: ${isPaid ? 'green' : 'red'}; font-weight: bold;">${isPaid ? 'Paid' : 'Outstanding Payment'}</span>
                
                ${project.image ? buildPortalPreviewLoaderMarkup() : ''}
                
                <hr style="border: none; border-top: 1px solid rgba(255, 255, 255, 0.1); margin: 25px 0;">
                
                <div style="margin-top: auto;">
                    <a ${downloadHref} class="${btnClass}" ${disabledAttr} style="text-align:center; display:flex; justify-content:center; align-items:center;">
                        <span class="icon-reverse-wrapper">
                            <span class="btn-text">${btnText}</span>
                            ${isPaid ? `<span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-down" aria-hidden="true"></i></span>
                            <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-down" aria-hidden="true"></i></span>` : ''}
                        </span>
                    </a>
                    ${!isPaid ? `<p class="modal-subtitle" style="text-align:center; margin-top:15px; color:#f80707;">Downloads are unlocked once the final invoice is settled.</p>` : ''}
                </div>
            `;

            modalScrollWrapper.innerHTML = projectHTML;

            if (project.image) {
                const previewSlot = modalScrollWrapper.querySelector("[data-portal-preview-slot]");
                if (previewSlot) mountPortalPreviewCard(previewSlot, project.image, project.projectName);
            }
        }

        // --- 4. Close Modals on Outside Click ---
        const successPopup = document.getElementById("successPopup"); // Defined here for the click listener
        window.addEventListener('click', (event) => { 
            if (event.target === portfolioModal && portfolioModal) portfolioModal.classList.remove("show"); 
            if (event.target === loginModal && loginModal) loginModal.classList.remove("show"); 
            if (event.target === servicesModal && servicesModal) closeServicesModal();
            if (event.target === successPopup && successPopup) successPopup.classList.remove("show"); 
        });

        // --- 5. WhatsApp Dynamic Toggle Logic (Targeting Services Form) ---
        const phoneInput = document.getElementById("servPhone");
        const whatsappContainer = document.getElementById("whatsappCheckboxContainer");
        const whatsappCheckbox = document.getElementById("servWhatsApp");

        if (phoneInput && whatsappContainer) {
            phoneInput.addEventListener('input', function() {
                if (phoneInput.value.trim().length > 0) {
                    whatsappContainer.style.display = 'flex';
                } else {
                    whatsappContainer.style.display = 'none';
                    if (whatsappCheckbox) whatsappCheckbox.checked = false;
                }
            });
        }

// --- 6. Form Submission & Success Popup Logic ---
        const servicesForm = document.getElementById("servicesForm");
        const closeSuccessBtn = document.getElementById("closeSuccessBtn");
        const closeSuccessPopupIcon = document.getElementById("closeSuccessPopupIcon");
        
        // Grab the dynamic popup elements
        const popupIconContainer = document.getElementById("popupIconContainer");
        const popupIcon = document.getElementById("popupIcon");
        const popupTitle = document.getElementById("popupTitle");
        const popupText = document.getElementById("popupText");

        if (servicesForm) {
            servicesForm.addEventListener("submit", async function(e) {
                e.preventDefault(); 
                
                // Gather data including your new fields
                const name = document.getElementById("servFullName").value;
                const email = document.getElementById("servEmail").value;
                const phone = document.getElementById("servPhone").value;
                const company = document.getElementById("servCompany").value;
                const website = document.getElementById("servWebsite").value;
                const whatsapp = document.getElementById("servWhatsApp").checked ? "Yes" : "No";
                const projectType = document.querySelector('input[name="servRequired"]:checked').value;
                
                const now = new Date();
                const projectDate = now.toLocaleDateString('en-GB'); 
                const time = now.toLocaleTimeString('en-US', { hour12: false }); 
                
                const payload = {
                    action: "signup", 
                    Name: name,
                    Contact: email,
                    Phone: phone,
                    Company: company,
                    Website: website,
                    WhatsApp: whatsapp,
                    ProjectType: projectType,
                    ProjectDate: projectDate,
                    Time: time,
                    Completion: "New"
                };

                const submitBtnText = servicesForm.querySelector(".btn-text");
                const originalText = submitBtnText.innerText;
                submitBtnText.innerText = "Submitting...";

                try {
                    const response = await fetch(GOOGLE_API_URL, {
                        method: "POST",
                        body: JSON.stringify(payload),
                        headers: { "Content-Type": "text/plain;charset=utf-8" }
                    });
                    
                    const data = await response.json();
                    
                    // Hide the form modal first
                    servicesModal.classList.remove("show");

                    if (data.success) {
                        // SUCCESS VIEW: Make the popup look like a win
                        if (popupIconContainer) popupIconContainer.style.color = "#FF8C33"; 
                        if (popupIcon) popupIcon.className = "fa-solid fa-circle-check";
                        if (popupTitle) popupTitle.innerText = "Project Started!";
                        if (popupText) popupText.innerText = "Thank you! Your project details have been successfully logged. We will review them and touch base with you shortly.";
                        
                        servicesForm.reset();
                        if (whatsappContainer) whatsappContainer.style.display = 'none';
                    } else {
                        // SERVER ERROR VIEW: Google Sheet returned success: false
                        if (popupIconContainer) popupIconContainer.style.color = "#f80707"; 
                        if (popupIcon) popupIcon.className = "fa-solid fa-circle-xmark";
                        if (popupTitle) popupTitle.innerText = "That Did Not Work";
                        if (popupText) popupText.innerText = "Unfortunately, we stumbled upon an issue processing your request. Please send us a WhatsApp on 077 420 4639 or email connect@azungu.co.za, and we’ll assist you directly.";
                    }
                    
                    // Show the formatted popup
                    successPopup.classList.add("show");

                } catch (error) {
                    console.error("Network Error:", error);
                    // NETWORK ERROR VIEW: Fetch failed completely (e.g., offline)
                    servicesModal.classList.remove("show");
                    
                    if (popupIconContainer) popupIconContainer.style.color = "#f80707";
                    if (popupIcon) popupIcon.className = "fa-solid fa-circle-xmark";
                    if (popupTitle) popupTitle.innerText = "Connection Issue";
                    if (popupText) popupText.innerText = "We can't reach the server right now. Please check your internet connection, or reach out to us directly.";
                    
                    successPopup.classList.add("show");
                } finally {
                    submitBtnText.innerText = originalText;
                }
            });
        }

        const hideSuccessPopup = () => successPopup.classList.remove("show");
        if (closeSuccessBtn) closeSuccessBtn.addEventListener("click", hideSuccessPopup);
        if (closeSuccessPopupIcon) closeSuccessPopupIcon.addEventListener("click", hideSuccessPopup);
    });
</script>

<Analytics/>
<SpeedInsights />
</body>
</html>
