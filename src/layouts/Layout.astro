<style is:inline>
        /* 1. Constrain the glass container height and hide its own overflow */
        .portfolio-modal-glass {
            max-height: 85vh;
            display: flex;
            flex-direction: column;
            overflow: hidden; /* This keeps the glass background solid and unbroken */
        }

        /* 2. Target the new inner wrapper to handle all the scrolling */
        .modal-scroll-wrapper {
            overflow-y: auto;
            overflow-x: hidden;
            scroll-behavior: smooth;
            padding-right: 15px; /* Spacing for the scrollbar */
            margin-right: -5px; /* Offsets padding slightly */
            flex-grow: 1; /* Fills up the remaining space inside the glass box */
        }

        /* 3. Custom Scrollbar Styling */
        .modal-scroll-wrapper::-webkit-scrollbar {
            width: 6px;
        }
        .modal-scroll-wrapper::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
            border-radius: 10px;
        }
        .modal-scroll-wrapper::-webkit-scrollbar-thumb {
            background: rgba(150, 150, 150, 0.4);
            border-radius: 10px;
        }
        .modal-scroll-wrapper::-webkit-scrollbar-thumb:hover {
            background: rgba(150, 150, 150, 0.7);
        }

        /* Loading treatment for sign-in and protected previews. */
        .shimmer-text {
            background: linear-gradient(90deg, rgba(255, 255, 255, 0.02) 0%, #ffffff 50%, rgba(255, 255, 255, 0.4) 100%);
            background-size: 200% auto;
            color: transparent !important;
            -webkit-background-clip: text;
            background-clip: text;
            animation: shimmer-load 1.5s linear infinite;
            display: inline-block;
        }

        @keyframes shimmer-load {
            from { background-position: 200% center; }
            to { background-position: -200% center; }
        }

        /* Inline loader shown in the project card while the preview image preloads. */
        .portal-preview-slot {
            width: 100%;
            min-height: 220px;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: transparent;
        }

        .portal-preview-loader {
            display: grid;
            place-items: center;
            align-content: center;
            gap: 16px;
            color: #ffffff;
            pointer-events: none;
        }

        .portal-preview-loader--inline {
            min-height: 220px;
            background: transparent;
        }

        .portal-preview-loader__mark {
            position: relative;
            width: 72px;
            height: 72px;
        }

        .portal-preview-loader__cube {
            position: absolute;
            inset: 8px;
            border-radius: 12px;
        }

        .portal-preview-loader__cube--colour {
            background: linear-gradient(135deg, #ffca18, #ff6f00);
            filter: blur(5px);
            animation: portal-preview-loader-spin 1.5s ease-in-out infinite;
        }

        .portal-preview-loader__cube--glass {
            border: 2px solid rgba(255, 255, 255, 0.62);
            background: rgba(255, 255, 255, 0.15);
            box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.38);
        }

        .portal-preview-loader__label {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.04em;
        }

        .portal-preview-loader.is-error .portal-preview-loader__cube--colour {
            animation: none;
            background: #e45b5b;
        }

        .portal-preview-loader.is-error .portal-preview-loader__label {
            color: #ffd4d4;
        }

        @keyframes portal-preview-loader-spin {
            0%, 100% { transform: rotate(0deg) scale(0.92); }
            50% { transform: rotate(-90deg) scale(1); }
        }
    </style>

    <div id="servicesModal" class="portfolio-modal-overlay">
