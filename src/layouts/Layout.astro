    <script is:inline src="assets/js/plugins/splittext.js"></script>
    <script is:inline src="assets/js/plugins/scrolltigger.js"></script>
    <script is:inline src="assets/js/plugins/scrolltoplugins.js"></script>
    <script is:inline src="assets/js/plugins/smoothscroll.js"></script>
