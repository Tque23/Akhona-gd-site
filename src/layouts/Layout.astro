    <script is:inline src="assets/js/plugins/gsap.js"></script>
    <script is:inline src="assets/js/plugins/splittext.js"></script>
    <script is:inline src="assets/js/plugins/scrolltigger.js"></script>
    <script is:inline src="assets/js/plugins/scrolltoplugins.js"></script>
    <script is:inline src="assets/js/plugins/smoothscroll.js"></script>
    <script is:inline src="assets/js/vendor/bootstrap.min.js"></script>
    <script is:inline src="assets/js/vendor/waw.js"></script>
    <script is:inline src="assets/js/plugins/isotop.js"></script>
    <script is:inline src="assets/js/plugins/animation.js"></script>
    <script is:inline src="assets/js/plugins/contact.form.js"></script>
    <script is:inline src="assets/js/vendor/backtop.js"></script>
    <script is:inline src="assets/js/plugins/text-type.js"></script>
