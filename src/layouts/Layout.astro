                    </div>
                    
                    <!-- Updated Link Container -->
                    <div class="modal-subtitle tmp-link-animation" style="display: flex; justify-content: space-between; align-items: center; gap: 15px;">
                        <a href="/404" class="number">Request Code</a>
                        <a href="/#start-your-project" class="openServicesModal number">First Time Here? Sign up</a>
                    </div>
                    
                    <!-- Added a top margin to space the submit button from the links -->
                    <button type="submit" class="tmp-btn hover-icon-reverse radius-round w-100" style="margin-top: 15px;">
                        <span class="icon-reverse-wrapper">
                            <span class="btn-text">Submit</span>
                            <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span>
                            <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span>
                        </span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div id="successPopup" class="portfolio-modal-overlay" style="z-index: 9999;">
        <div class="portfolio-modal-glass tmponhover" style="text-align: center; padding: 40px 30px; max-width: 450px; margin: auto; height: auto;">
            <span class="portfolio-modal-close" id="closeSuccessPopupIcon">&times;</span>
            
            <div id="popupIconContainer" style="font-size: 50px; color: #FF8C33; margin-bottom: 20px;">
                <i id="popupIcon" class="fa-solid fa-circle-check" aria-hidden="true"></i>
            </div>
            
            <h3 id="popupTitle" class="modal-title" style="margin-bottom: 15px;">Project Started!</h3>
            <p id="popupText" class="modal-subtitle" style="font-size: 16px; margin-bottom: 30px;">Thank you! Your project details have been successfully submitted. We will review them and get back to you shortly.</p>
            
            <button type="button" id="closeSuccessBtn" class="tmp-btn hover-icon-reverse radius-round w-100">
                <span class="icon-reverse-wrapper">
                    <span class="btn-text">Awesome</span>
                    <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span>
                    <span class="btn-icon"><i class="fa-sharp fa-regular fa-arrow-right" aria-hidden="true"></i></span>
                </span>
            </button>
        </div>
    </div>

    <script is:inline src="assets/js/vendor/jquery.js"></script>
